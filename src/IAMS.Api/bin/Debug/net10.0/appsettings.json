{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=IAMS;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "iams",
    "Audience": "iams-mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "TwoFactorCodeTtlSeconds": 300,
    "TwoFactorResendCooldownSeconds": 30,
    "TwoFactorMaxAttempts": 5
  }
}
